{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "pulsegate-local",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "d1_databases": [{ "binding": "DB", "database_name": "pulsegate-db", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "GATEWAY_STATE", "class_name": "GatewayState" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GatewayState"] }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": { "DEV_MODE": "true" }
}
