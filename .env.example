# Default deployment opens the initialization wizard. No .env is required.
PORT=8787
# Optional override of the public browser origin; otherwise set it in the wizard.
PUBLIC_URL=
DATA_DIR=./data
DEV_MODE=false

# Optional bundled database passwords (use npm run setup:local to generate).
# Only needed with compose.postgres.yaml / compose.mysql.yaml.
POSTGRES_PASSWORD=
MYSQL_PASSWORD=

# Optional concurrency tuning (per channel).
CHANNEL_MAX_CONCURRENCY=64
CONNECT_TIMEOUT=5s
RESPONSE_HEADER_TIMEOUT=30s
STREAM_IDLE_TIMEOUT=60s
STREAM_MAX_DURATION=20m
REQUEST_TIMEOUT=20m
DOWNSTREAM_WRITE_TIMEOUT=30s
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN=15s
LOG_QUEUE_SIZE=4096
LOG_WORKERS=4
DB_MAX_OPEN_CONNS=32
DB_MAX_IDLE_CONNS=16

# Existing installations may continue using the complete legacy trio instead
# of the wizard. Omit all three for a fresh installation; persisted config wins.
# DATABASE_URL=postgres://user:password@host:5432/pulsegate?sslmode=disable
# ADMIN_TOKEN=at_least_24_random_characters
# ENCRYPTION_KEY=base64_encoded_32_byte_key
